      <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="10dp" android:text="Bike – · Garmin –" android:textColor="@color/muted" android:textSize="12sp" android:visibility="gone" />
