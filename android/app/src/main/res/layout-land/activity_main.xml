    <TextView android:id="@+id/tabHistory" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:paddingVertical="3dp" android:drawableTop="@drawable/nav_history" android:drawablePadding="1dp" android:text="@string/ui_history_528" android:textSize="11sp" android:textColor="@color/muted" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground" />
