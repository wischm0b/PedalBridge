<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background" android:fitsSystemWindows="true">
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
