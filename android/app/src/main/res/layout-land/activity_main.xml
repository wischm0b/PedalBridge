            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:layout_marginStart="5dp" android:layout_marginEnd="0dp" android:background="@drawable/metric_background">
